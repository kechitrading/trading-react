# Add to the aqta nginx site (aqta/deploy/nginx/aqta.conf.example) to serve the dashboard from the
# same origin as the API. Copy `npm run build` output (dist/) to /opt/aqta/webapp.
# Keep the existing TLS, allow-list (NFR-009) and security headers from that file.

    # API and probes go to FastAPI (replace the existing `location /` block).
    location ~ ^/(api|health|ready)(/|$) {
        limit_req zone=aqta_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }

    # Hashed build assets can be cached for a long time.
    location /assets/ {
        root /opt/aqta/webapp;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    # Single-page app: unknown paths fall back to index.html, which is never cached.
    location / {
        root /opt/aqta/webapp;
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" always;
    }
